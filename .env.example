# Sao chép file này thành .env rồi chỉnh giá trị
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/auth-api-tutorial
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
NODE_ENV=development

# Paste the complete Firebase service-account JSON on one line.
# Railway: add this value in Variables; local: add it to .env.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
